# Generated by scripts/render.py from members.toml and connectors/email-imap.
# ${VAR} placeholders are substituted inside the container at start.
[settings]
rate_limit = 10
read_only = false
{{#each connector.accounts as account}}

[[accounts]]
name = "{{account.name}}"
email = "{{account.email}}"
password = "{{account.password}}"
[accounts.imap]
host = "{{account.imap_host}}"
port = {{account.imap_port}}
tls = true
[accounts.smtp]
host = "smtp.invalid"
port = 25
tls = false
{{/each}}
